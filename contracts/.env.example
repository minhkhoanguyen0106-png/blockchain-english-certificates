# ===================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO MODULE SMART CONTRACTS
# ===================================================

# Private key của ví deployer (Bắt đầu không có '0x')
PRIVATE_KEY=your_private_key_here

# RPC URLs cho các mạng Testnet
SEPOLIA_RPC_URL=https://rpc.sepolia.org
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Etherscan / Polygonscan API Keys (Dùng để verify contract trên blockchain explorer)
ETHERSCAN_API_KEY=your_etherscan_api_key_here
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# Cấu hình IPFS Pinata (Để upload metadata & phôi bằng phi tập trung)
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_KEY=your_pinata_secret_key_here
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/
