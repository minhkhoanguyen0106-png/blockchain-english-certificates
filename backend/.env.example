PORT=5000
NODE_ENV=development

# MySQL Database Configuration (Local hoặc Aiven Cloud)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=EnglishCertificate
DB_PORT=3306
DB_SSL=false

# Service URI (Nếu dùng Aiven Cloud)
# DATABASE_URL=mysql://avnadmin:PASSWORD@HOST:PORT/EnglishCertificate?ssl-mode=REQUIRED

# JWT Authentication Secret
JWT_SECRET=super_secret_jwt_key_english_cert_blockchain_2026
