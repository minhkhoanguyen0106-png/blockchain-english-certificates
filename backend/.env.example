# Public Verify Base URL (nhúng vào mã QR)
PUBLIC_VERIFY_BASE_URL=http://localhost:5173/verify

# Smart Contract Configuration (Tùy chọn: ghi đè địa chỉ mặc định trong EnglishCertificateNFT.json)
